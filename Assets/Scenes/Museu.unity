    - target: {fileID: 5925083127469288215, guid: cf36fdbaec3ab46478fb5495161dbe71, type: 3}
      propertyPath: m_text
      value: "Elden Ring, lan\xE7ado em 25 de fevereiro de 2022, \xE9 um RPG de a\xE7\xE3o
        desenvolvido pela FromSoftware e publicado pela Bandai Namco Entertainment,
        com cria\xE7\xE3o de mundo em colabora\xE7\xE3o com o escritor George R.R.
        Martin.\n\nO jogador assume o papel de um Tarnished, um exilado sem gra\xE7a,
        que retorna \xE0s Terras Interm\xE9dias para desafiar semideuses corrompidos,
        reunir os fragmentos do Anel Pr\xEDstino e se tornar o Lorde Pr\xEDstino.
        O jogo expande a f\xF3rmula da FromSoftware para um enorme mundo aberto repleto
        de segredos, masmorras e combates brutais.\n\nO jogo foi o vencedor da edi\xE7\xE3o
        do The Game Awards 2022, competindo com t\xEDtulos como A Plague Tale: Requiem,
        God of War Ragnar\xF6k, Horizon Forbidden West, Stray e Xenoblade Chronicles
        3."
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: cf36fdbaec3ab46478fb5495161dbe71, type: 3}
